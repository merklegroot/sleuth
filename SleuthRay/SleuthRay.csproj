<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Raylib-cs" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\wanderer_talk.json" LogicalName="wanderer_talk.json" />
    <EmbeddedResource Include="Resources\gunshot.wav" LogicalName="gunshot.wav" />
    <EmbeddedResource Include="assets\sounds\mixkit-sweet-kitty-meow-93-trimmed.wav" LogicalName="mixkit-sweet-kitty-meow-93-trimmed.wav" />
    <EmbeddedResource Include="res\cat_names.txt" LogicalName="cat_names.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\gamecontrollerdb_xbox_mac.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\cats\cat-a.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\cats\cat-b.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\cats\cat-c.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
